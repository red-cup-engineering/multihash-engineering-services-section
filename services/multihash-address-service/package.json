{
  "name": "@red-cup-engineering/multihash-address-service",
  "version": "0.1.3",
  "type": "module",
  "description": "Creates, reads, and verifies base32 presentations of SHA-2 multihash byte commitments.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/multihash-engineering-services-section.git",
    "directory": "services/multihash-address-service"
  },
  "license": "MIT",
  "exports": {
    "./create-multihash": {
      "types": "./scripts/create-multihash.d.mts",
      "import": "./scripts/create-multihash.mjs"
    },
    "./read-multihash": {
      "types": "./scripts/read-multihash.d.mts",
      "import": "./scripts/read-multihash.mjs"
    },
    "./verify-multihash": {
      "types": "./scripts/verify-multihash.d.mts",
      "import": "./scripts/verify-multihash.mjs"
    },
    "./address": "./src/multihash-address.mjs"
  },
  "bin": {
    "create-multihash": "./scripts/create-multihash.mjs",
    "read-multihash": "./scripts/read-multihash.mjs",
    "verify-multihash": "./scripts/verify-multihash.mjs"
  },
  "files": [
    "README.md",
    "content",
    "scripts",
    "src",
    "docs/API.md",
    "examples/quickstart.test.mjs"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "dependencies": {
    "multiformats": "14.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
